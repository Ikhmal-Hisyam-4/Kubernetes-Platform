# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is gitignored — never commit it.

aws_region = "ap-southeast-5"

ssh_public_key = "ssh-ed25519 AAAA... your-public-key-here"

# Your own IP only — find it with: curl ifconfig.me
# Never leave this as 0.0.0.0/0, it exposes SSH and the k3s API to the internet.
ssh_allowed_cidr = "YOUR.IP.ADDR.ESS/32"
